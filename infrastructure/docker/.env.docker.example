# ─────────────────────────────────────────────────────────────────────────────
# Aura Clinical — Docker Environment Variables Template
# Copy this file to `.env.docker` and fill in the values.
# NEVER commit .env.docker to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=clinical_platform
POSTGRES_USER=aura_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://aura_redis:6379

# ── Database URL (Drizzle ORM) ───────────────────────────────────────────────
DATABASE_URL=postgresql://aura_admin:CHANGE_ME_STRONG_PASSWORD@aura_postgres:5432/clinical_platform

# ── API Service ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_BASE_URL=http://aura_api:3001

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHAR_RANDOM_SECRET_FOR_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_64_CHAR_RANDOM_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── LiveKit WebRTC SFU ────────────────────────────────────────────────────────
LIVEKIT_URL=ws://aura_livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_MIN_32_CHARS

# ── MinIO Document & Imaging Vault ────────────────────────────────────────────
MINIO_ENDPOINT=aura_minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_aura_admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# ── Frontend Applications (Next.js public env) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ── Clinical Platform Identity ────────────────────────────────────────────────
PLATFORM_NAME=Aura Clinical Health Alliance
PLATFORM_JURISDICTION=NG,GB
AUDIT_CHAIN_SEED=CHANGE_ME_AUDIT_GENESIS_SEED_SHA256
